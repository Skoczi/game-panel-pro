#!/usr/bin/env python3
import hashlib
import json
import os
from pathlib import Path
import shutil
import sys

base = Path('/opt/classic-base')
target = Path('/data/serverfiles')
shared = {'bin', 'csgo', 'platform', 'csco/csgo/vpks'}
dependency = [{'package':'classic-offensive-1_0_2','sha256':'928e35bab55e1bfdbc35cdc37b1fbc9201205d29db140fc126375f2e03b37ad1'}]
for name in ['srcds_linux','srcds_run','csco/csgo/gameinfo.txt','bin/engine.so','csgo/bin/server.so']:
    if not (base/name).is_file():
        raise SystemExit('Classic Offensive shared package is incomplete: ' + name)
if len(sys.argv) > 1 and sys.argv[1] == 'verify':
    if json.loads((target/'.eserv-shared-files.json').read_text()) != dependency:
        raise SystemExit('Shared package dependency mismatch')
    print('Classic Offensive 1.0.2 · shared package ready. Configuration unchanged.', flush=True)
    sys.exit(0)
target.mkdir(exist_ok=True)
if (target/'srcds_run').exists():
    raise SystemExit('Game files already exist; refusing to overwrite configuration')
files = [p for p in base.rglob('*') if p.is_file() and not any(p.relative_to(base).as_posix() == d or p.relative_to(base).as_posix().startswith(d+'/') for d in shared)]
total = sum(p.stat().st_size for p in files)
copied = 0
last = -1
for source in files:
    relative = source.relative_to(base)
    destination = target/relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, destination)
    destination.chmod(0o755 if source.stat().st_mode & 0o111 else 0o644)
    copied += source.stat().st_size
    percent = int(copied*100/max(total,1))
    if percent//10 != last:
        last = percent//10
        print(f'Preparing private game files · {percent}%', flush=True)
for name in ['srcds_run','srcds_linux']:
    (target/name).chmod(0o755)
game = target/'csco/csgo'
# This template is pinned to the local 1.0.2 package. Never let the client updater
# rewrite the server's package independently of its shared readonly dependencies.
info = game/'gameinfo.txt'
info.write_text('\n'.join(line for line in info.read_text().splitlines() if 'updatemanifesturl' not in line.lower())+'\n')
state = {}
for module, version in [('metamod','2.0.0.1350'),('sourcemod','1.13.0.7243')]:
    print(f'Installing {module} {version}', flush=True)
    manifest = {}
    for source in (Path('/opt/classic-frameworks')/module).rglob('*'):
        if not source.is_file(): continue
        relative = source.relative_to(Path('/opt/classic-frameworks')/module)
        if relative.as_posix() == 'addons/metamod_x64.vdf': continue
        destination = game/relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source,destination)
        destination.chmod(0o644)
        if relative.as_posix() == 'addons/metamod.vdf':
            destination.write_text('"Plugin"\n{\n  "file" "csco/csgo/addons/metamod/bin/server"\n}\n')
        manifest[destination.relative_to(Path('/data')).as_posix()] = hashlib.sha256(destination.read_bytes()).hexdigest()
    state[module] = {'version':version,'files':manifest}
(target/'.eserv-source-addons.json').write_text(json.dumps(state))
(target/'.eserv-shared-files.json').write_text(json.dumps(dependency,separators=(',',':')))
cfg = game/'cfg/server.cfg'
if not cfg.exists(): cfg.write_text('hostname "Classic Offensive"\nsv_lan 0\nbot_quota 0\n')
cycle = game/'mapcycle.txt'
if not cycle.exists(): cycle.write_text('de_dust2_csco\n')
print('Classic Offensive 1.0.2 · Metamod + SourceMod ready', flush=True)
