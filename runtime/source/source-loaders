#!/usr/bin/env python3
"""Restore only panel-managed CS2 search paths after a Valve update."""
import json, pathlib, re, sys, os, tempfile
root = pathlib.Path(sys.argv[1])
state = root / '.eserv-source-loaders.json'
if not state.exists():
    sys.exit(0)
if state.is_symlink():
    raise RuntimeError('Loader state cannot be a symlink')
loaders = json.loads(state.read_text())
paths = {'metamod': 'csgo/addons/metamod', 'modsharp': 'sharp', 'swiftlys2': 'csgo/addons/swiftlys2'}
assert isinstance(loaders, list) and all(x in paths for x in loaders)
if 'modsharp' in loaders and any(x in loaders for x in ('metamod', 'swiftlys2')):
    raise RuntimeError('ModSharp requires a separate loader setup')
filename = root / 'game/csgo/gameinfo.gi'
assert not filename.is_symlink()
content = filename.read_text()
for value in paths.values():
    content = re.sub(r'^[ \t]*Game[ \t]+"?' + re.escape(value) + r'"?[ \t]*(?://[^\r\n]*)?(?:\r?\n|$)', '', content, flags=re.M)
anchor = re.search(r'^[ \t]*Game[ \t]+"?csgo"?[ \t]*(?://[^\r\n]*)?$', content, re.M)
if not anchor:
    raise RuntimeError('Cannot locate CS2 game search path')
content = content[:anchor.start()] + ''.join('\t\t\tGame\t' + p + '\n' for k, p in paths.items() if k in loaders) + content[anchor.start():]
with tempfile.NamedTemporaryFile(mode='w', dir=filename.parent, prefix='.eserv-loaders-', delete=False) as output:
    temporary = pathlib.Path(output.name)
    output.write(content)
    output.flush()
    os.fsync(output.fileno())
try:
    os.chmod(temporary, filename.stat().st_mode & 0o777)
    os.replace(temporary, filename)
finally:
    temporary.unlink(missing_ok=True)
